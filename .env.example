# Public credentials: safe for browser bundles; never put a service-role key here.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Canonical origin used in recovery and email-change links; localhost allowed for development.
NEXT_PUBLIC_APP_URL=https://admin.ese-llc.com

# Provision staff Auth accounts and matching active staff rows through Supabase.
# Disable public signups in Supabase Auth. Allow /auth/confirm for canonical,
# temporary workers.dev, and localhost origins in Supabase redirect settings.
# Auth email templates should link to /auth/confirm?token_hash={{ .TokenHash }}&type=recovery&next=/account
# Use the matching type=email_change for change-email confirmations.
